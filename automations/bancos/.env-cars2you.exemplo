# Modelo. Copie para FORA do repo e preencha la:
#   cp automations/bancos/.env-cars2you.exemplo ~/.cars2you-db.env
#
# Prefixo C2Y de proposito: impede usar por engano o arquivo da Dealers,
# que usa DLC.
#
# ⚠️ Use um usuario SOMENTE LEITURA. E producao.

C2Y_HOST=<host do RDS da Cars2You>
C2Y_PORT=3306
C2Y_USER=<usuario_somente_leitura>
C2Y_PASS=<senha>
C2Y_DB=cars2you_production
